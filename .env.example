# Payload secret (generate one: openssl rand -base64 32)
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URI=postgres://user:password@host:5432/dbname

# Public site URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary credentials — find them in https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (https://resend.com) — required to send subscriber notifications
RESEND_API_KEY=
RESEND_FROM="Blog <onboarding@resend.dev>"

# Shared secret used to authorize the /api/cron/notify-scheduled endpoint
# (Vercel Cron passes the project's CRON_SECRET as `Authorization: Bearer <secret>`)
CRON_SECRET=
